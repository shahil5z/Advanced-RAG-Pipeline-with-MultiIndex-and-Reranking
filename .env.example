# Server-side only. The generator reads the key from the process environment.
# The package does not load secret files. Do not commit a value, and do not
# use a public browser prefix. The public site does not need the key.

# Optional. Absolute URL used for Open Graph metadata. Defaults to the
# production Vercel domain when unset.
# NEXT_PUBLIC_SITE_URL=https://advanced-rag-evaluation.vercel.app
